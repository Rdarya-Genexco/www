{
  "name": "worldwide-wheels",
  "productName": "Worldwide Wheels",
  "version": "1.0.0",
  "description": "Worldwide Wheels: an arcade street racer across India, Brazil, Mexico and Japan.",
  "author": "Worldwide Wheels",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.worldwidewheels.game",
    "productName": "Worldwide Wheels",
    "directories": { "output": "dist" },
    "files": ["main.js", "app/**/*"],
    "win": {
      "target": ["portable", "nsis"],
      "icon": "build/icon.png"
    },
    "portable": { "artifactName": "WorldwideWheels-portable.exe" },
    "nsis": {
      "artifactName": "WorldwideWheels-Setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
